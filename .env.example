# Plantilla de variables de entorno. Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore — nunca se commitea.

# API key de NVD (NIST National Vulnerability Database)
# Solicitar en: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY= 

# (Opcional) Configuración de la web app
APP_HOST=127.0.0.1
APP_PORT=8000
